{
  "name": "@nudgekit/react-native",
  "version": "0.1.0",
  "description": "React Native / Expo bindings for NudgeKit — contextual tips, feature discovery, and onboarding nudges. Pure TypeScript engine + managers + UI, parity-tested with Kotlin NudgeKit 1.0.0.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Abdullajon1881",
  "homepage": "https://github.com/Abdullajon1881/AndroidTipKit/tree/main/packages/react-native#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abdullajon1881/AndroidTipKit.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/Abdullajon1881/AndroidTipKit/issues"
  },
  "keywords": [
    "nudgekit",
    "tips",
    "tooltip",
    "onboarding",
    "feature-discovery",
    "react-native",
    "expo"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": ["lib"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
